{
  "name": "@lunarhue/table-e2e-react18",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The React app built against React 18. It has a package of its own so its React, not the workspace's, is the one installed beside it.",
  "dependencies": {
    "@lunarhue/table-e2e": "workspace:*",
    "@lunarhue/table-e2e-react-shared": "workspace:*",
    "react": "catalog:react18",
    "react-dom": "catalog:react18"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite": "catalog:"
  },
  "scripts": {
    "build": "vite build && vite build --ssr src/entry-server.tsx",
    "typecheck": "tsc -p tsconfig.json"
  }
}
